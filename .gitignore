# Downloaded OpenLimbTT data (CC-BY-SA-4.0) is NOT vendored -- fetch at runtime.
data/openlimb/*
!data/openlimb/.gitkeep

# Pipeline outputs (meshes, heatmaps, logs)
data/out/*
!data/out/.gitkeep
*.stl
*.glb
*.ply
session_log*.jsonl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# OS / editor
.DS_Store
*.swp
